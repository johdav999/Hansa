+    {Good(TEXT("Good.PreservedFish")),FHansaQuantity::FromRaw(Fish/Stores+(N==1?Fish%Stores:0))},
+    {Good(TEXT("Good.Salt")),FHansaQuantity::FromRaw(Inputs?8000:0)},{Good(TEXT("Good.Barrels")),FHansaQuantity::FromRaw(Inputs?400:0)}};
