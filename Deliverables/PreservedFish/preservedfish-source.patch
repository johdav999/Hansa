+       const int Y=Side==2?Spec.Anchor.Y-1:Side==3?Spec.Anchor.Y+Fishery->FootprintHeightCells:Spec.Anchor.Y;
+       Build->SelectBuilding(TEXT("Building.Road"));Build->TargetGridCell(X,Y);
