{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hansa-generation-manifest-v1",
  "title": "Hansa immutable generation job manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocolVersion", "jobId", "revision", "attempt", "capability", "intendedAssetRole", "provider", "requestHash", "inputHash", "status", "timestamps", "outputs", "errors", "qaResults", "provenance", "review", "manifestHash"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "protocolVersion": { "const": "1.0" },
    "jobId": { "type": "string", "format": "uuid" },
    "parentJobId": { "type": ["string", "null"] },
    "revision": { "type": "integer", "minimum": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "capability": { "type": "string" },
    "intendedAssetRole": { "type": "string" },
    "provider": { "type": "object" },
    "providerJobId": { "type": ["string", "null"] },
    "requestHash": { "$ref": "#/$defs/hash" },
    "inputHash": { "$ref": "#/$defs/hash" },
    "prompt": { "type": "string" },
    "promptSha256": { "$ref": "#/$defs/hash" },
    "negativePrompt": { "type": "string" },
    "inputArtifacts": { "type": "array" },
    "rights": { "type": "object" },
    "budgets": { "type": "object" },
    "estimate": { "type": "object" },
    "actualUsage": { "type": ["object", "null"] },
    "outputContract": { "type": "object" },
    "seed": { "type": ["integer", "null"] },
    "parameters": { "type": "object" },
    "status": { "enum": ["Review", "Failed", "Cancelled", "Expired"] },
    "progress": { "type": "object" },
    "timestamps": { "type": "object" },
    "retryLineage": { "type": "array" },
    "outputs": { "type": "array" },
    "errors": { "type": "array" },
    "qaResults": { "type": "array" },
    "provenance": { "type": "object" },
    "review": { "type": "object" },
    "manifestHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
