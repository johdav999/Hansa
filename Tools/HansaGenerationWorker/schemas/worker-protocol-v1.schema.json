{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hansa-generation-worker-protocol-v1",
  "title": "Hansa generation worker framed local protocol",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/failure" }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["protocol", "version", "requestId"],
      "properties": {
        "protocol": { "const": "hansa.generation.worker" },
        "version": { "const": "1.0" },
        "requestId": { "type": "string", "minLength": 8, "maxLength": 128 }
      }
    },
    "request": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["protocol", "version", "requestId", "authToken", "operation", "payload"],
          "properties": {
            "protocol": { "const": "hansa.generation.worker" }, "version": { "const": "1.0" },
            "requestId": { "type": "string" }, "authToken": { "type": "string", "minLength": 16, "maxLength": 128 },
            "operation": { "enum": ["worker.capabilities", "job.estimate", "job.submit", "job.get", "job.output.read", "job.list", "job.cancel", "job.retry", "job.resume", "job.media.retain"] },
            "payload": { "type": "object" }
          }
        }
      ]
    },
    "success": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "version", "requestId", "ok", "result"],
      "properties": {
        "protocol": { "const": "hansa.generation.worker" }, "version": { "const": "1.0" },
        "requestId": { "type": "string" }, "ok": { "const": true }, "result": { "type": "object" }
      }
    },
    "failure": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "version", "requestId", "ok", "error"],
      "properties": {
        "protocol": { "const": "hansa.generation.worker" }, "version": { "const": "1.0" },
        "requestId": { "type": "string" }, "ok": { "const": false },
        "error": {
          "type": "object", "additionalProperties": true,
          "required": ["code", "message", "remedy", "retryable"],
          "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "remedy": { "type": "string" }, "retryable": { "type": "boolean" } }
        }
      }
    }
  }
}

