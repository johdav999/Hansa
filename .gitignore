# Unreal Engine generated directories (project and plugins)
# Local verification project copies are generated, not source.
/.codex-build/
**/Binaries/
**/DerivedDataCache/
**/Intermediate/
**/Saved/

# UBT reads this project-scoped source setting even when project files are
# regenerated by the Editor or Explorer shell integration. Everything else
# beneath Saved remains transient.
!Saved/
Saved/*
!Saved/UnrealBuildTool/
Saved/UnrealBuildTool/*
!Saved/UnrealBuildTool/BuildConfiguration.xml

# AI/media imports are transient until explicitly reviewed and promoted.
Content/Hansa/Generated/Staging/

# Generated project and workspace files
.vs/
.vscode/
.idea/
*.code-workspace
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.db-shm
*.VC.db-wal
*.VC.opendb
*.xcodeproj/
*.xcworkspace/

# Build-system files generated by UnrealBuildTool
Makefile
CMakeLists.txt
CMakeSettings.json
cmake-build-*/

# Local caches, logs, and crash reports
# Blender recovery copies and regenerable NumPy terrain arrays stay local.
*.blend1
*.npy
# Local-only asset archives: keep final masters, production Content and scripts.
# User-approved whole-tree source archive; including its embedded scripts/masters.
/SourceArt/Generated/
# Keep this reviewed merchant-office source package alongside its imported assets.
!/SourceArt/Generated/
/SourceArt/Generated/*
!/SourceArt/Generated/Buildings/
/SourceArt/Generated/Buildings/*
!/SourceArt/Generated/Buildings/MerchantOffice/
/Deliverables/PreservedFish/preservedfish-candidate.zip
/SourceArt/Terrain/HansaWorld/Prototype_20260918/sources/etopo.tif
/SourceArt/Generated/**/checkpoints/*.blend
