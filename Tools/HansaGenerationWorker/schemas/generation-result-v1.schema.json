{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hansa-generation-result-v1",
  "title": "Hansa normalized provider result",
  "type": "object",
  "additionalProperties": false,
  "required": ["resultContractVersion", "artifacts", "usage", "providerJobId"],
  "properties": {
    "resultContractVersion": { "const": 1 },
    "artifacts": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["logicalName", "mediaType", "contentBase64"],
        "properties": {
          "logicalName": { "type": "string", "minLength": 1, "maxLength": 128 },
          "mediaType": { "type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$" },
          "contentBase64": { "type": "string", "contentEncoding": "base64" }
        }
      }
    },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["currency", "actualMinorUnits", "usageUnit", "actualUsage"],
      "properties": {
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "actualMinorUnits": { "type": "integer", "minimum": 0 },
        "usageUnit": { "type": "string" },
        "actualUsage": { "type": "number", "minimum": 0 }
      }
    },
    "providerJobId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "contractHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "proposalHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "model": { "type": "string", "minLength": 1, "maxLength": 256 }
  }
}
