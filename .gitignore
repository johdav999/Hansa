*.tmp
*.user
*.userprefs
crashinfo--*

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini

# Documentation and non-runtime reference art stay local (2026-10-03).
# Preserve machine-readable fixtures/inputs and regeneration tools in these trees.
# Restore the local documentation/art archive for reference-led authoring or UAT.
/Docs/**
!/Docs/**/
!/Docs/**/*.json
!/Docs/**/*.csv
!/Docs/**/*.yaml
!/Docs/**/*.yml
!/Docs/**/*.py
!/Docs/**/*.ps1
